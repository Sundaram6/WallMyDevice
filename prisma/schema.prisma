datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id              String           @id @default(cuid())
  name            String?
  email           String?          @unique
  password        String?
  image           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  savedWallpapers SavedWallpaper[]
}

model SavedWallpaper {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String?
  recipe     String   // Store serialized recipe JSON (generatorId + seed + palette + params)
  deviceType String   @default("desktop")
  createdAt  DateTime @default(now())
}
